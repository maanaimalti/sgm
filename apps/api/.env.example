DATABASE_URL="file:./sgm.db"

# Storage: "r2" (default, production) or "local" (saves PDFs to disk during dev).
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./uploads
# LOCAL_STORAGE_PUBLIC_URL=http://localhost:3333/uploads

# R2 (only used when STORAGE_DRIVER=r2)
# R2_ENDPOINT=
# R2_PUBLIC_URL=https://pub-02162cc0773546efb6b651c10eb87288.r2.dev/

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# When unset, push is disabled (in-app notifications still work).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@maanaim.app
