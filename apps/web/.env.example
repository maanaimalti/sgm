NEXT_PUBLIC_BASE_URL=

# Supabase Auth. Both are compiled into the browser bundle, which is expected:
# the anon key is a public identifier, not a secret. It is also why every table
# in the database has row level security enabled with no policies — without
# that, this key would make PostgREST a public read API over the whole schema.
# Must be the same project the API points at.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# VAPID public key for Web Push. Must match the API's VAPID_PUBLIC_KEY.
# Optional: the app also fetches it from GET /push/public-key at runtime.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
