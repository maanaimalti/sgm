{
  "name": "sgm",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @sgm/api start:dev",
    "dev:web": "pnpm --filter @sgm/web dev",
    "build:api": "pnpm --filter @sgm/api build",
    "build:web": "pnpm --filter @sgm/web build",
    "build:shared": "pnpm --filter @sgm/shared build",
    "lint:api": "pnpm --filter @sgm/api lint",
    "lint:web": "pnpm --filter @sgm/web lint",
    "typecheck": "pnpm -r typecheck"
  }
}
