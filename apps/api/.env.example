# Postgres. Use the Supavisor SESSION pooler (port 5432) for both, not the
# transaction pooler on 6543: the API is a long-lived process and two of its
# transactions are interactive, which would pin a pooled connection.
DATABASE_URL="postgresql://postgres:sgm@localhost:5433/sgm"
DIRECT_URL="postgresql://postgres:sgm@localhost:5433/sgm"

# Legacy MySQL — read-only source for prisma/migrate-mysql-to-postgres.ts.
# Only needed while the Stage A migration is being rehearsed or executed.
# LEGACY_DATABASE_URL="mysql://root:sgm@localhost:3306/sgm"

# Supabase Auth. All three are required — the API refuses to boot without them.
# Point a local .env at a SEPARATE dev project, never at production: the
# service-role key below can create and delete real accounts.
#
# SUPABASE_URL must be the bare origin, no trailing slash and no path. It also
# derives the JWT issuer the API checks every token against, and a mismatch
# there shows up only as 401 on every request.
SUPABASE_URL="https://<ref>.supabase.co"
# Public by design — the same key ships in the web bundle. That is precisely
# why every table has RLS enabled with no policies.
SUPABASE_ANON_KEY=
# Ignores RLS and every @Roles check in this codebase. Server-side only; it must
# never end up in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# Required — the API refuses to boot without it.
JWT_SECRET=

# Session lifetime. Any value the `ms` package understands (15m, 12h, 7d).
# JWT_EXPIRES_IN=12h

# Storage: "r2" (default, production) or "local".
# "local" serves /uploads with no authentication — development only.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=./uploads
# LOCAL_STORAGE_PUBLIC_URL=http://localhost:3333/uploads

# R2 (only used when STORAGE_DRIVER=r2). The bucket must be PRIVATE: downloads
# are handed out as signed URLs, and it needs a CORS rule allowing GET from the
# web origin so the browser can fetch the PDF.
# R2_ENDPOINT=
# R2_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# When unset, push is disabled (in-app notifications still work).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@maanaim.app
