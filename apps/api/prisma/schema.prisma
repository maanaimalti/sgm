generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum orderStatus {
  PENDING
  APPROVED
  REJECTED
  PURCHASED
  CANCELED

  @@map("order_status")
}

enum movementType {
  in
  out
}

model category {
  id          String  @id
  name        String
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  product   product[]

  @@map("categories")
}

model unity {
  id          String    @id
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     product[]

  @@map("unities")
}

model product {
  id              String   @id
  name            String
  brand           String?
  description     String?
  categoryId      String
  departmentId    String?
  unityId         String
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  productValuesId String?
  costValue       Float    @map("cost_value")
  saleValue       Float?   @map("sale_value")
  minStock        Int?     @default(0) @map("min_stock")

  department department? @relation(fields: [departmentId], references: [id])
  category   category    @relation(fields: [categoryId], references: [id])
  unity      unity       @relation(fields: [unityId], references: [id])
  movement   movement[]
  orderItem  orderItem[]
  stock      stock[]

  @@map("products")
}

model movement {
  id        String       @id
  productId String
  quantity  Float
  type      movementType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  product product @relation(fields: [productId], references: [id])

  @@map("movements")
}

model stock {
  id        String   @id
  productId String
  quantity  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product product @relation(fields: [productId], references: [id])

  @@map("stocks")
}

model user {
  id           String         @id
  name         String
  username     String         @unique
  password     String
  roles          role[]
  orders         orders[]
  approvedOrders orders[]       @relation("approvedOrders")
  rejectedOrders orders[]       @relation("rejectedOrders")
  orderReports   orderReports[]
  notification   notification[]
  department     department[]
  reports        report[]
  orderEvents    orderEvent[]
  pushSubscriptions pushSubscription[]

  @@map("users")
}

model role {
  id          String       @id
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       user[]
  permissions permission[]

  @@map("roles")
}

model permission {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles     role[]

  @@map("permissions")
}

model orders {
  id           String   @id
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  observation  String?
  event        String?
  friendlyCode String?  @unique @map("friendly_code")

  status             orderStatus @default(PENDING)
  statusObservation  String?     @map("status_observation")

  approvedById String?   @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  rejectedById String?   @map("rejected_by_id")
  rejectedAt   DateTime? @map("rejected_at")

  user         user           @relation(fields: [userId], references: [id])
  approvedBy   user?          @relation("approvedOrders", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectedBy   user?          @relation("rejectedOrders", fields: [rejectedById], references: [id], onDelete: SetNull)
  orderItem    orderItem[]
  orderReports orderReports[]
  events       orderEvent[]

  @@index([approvedById])
  @@index([rejectedById])
  @@map("orders")
}

model order_counter {
  id    Int @id @default(1)
  value Int @default(0)

  @@map("order_counter")
}

model orderEvent {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  type      String
  userId    String   @map("user_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  order orders @relation(fields: [orderId], references: [id])
  user  user   @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@map("order_events")
}

model orderItem {
  id        String   @id
  orderId   String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   orders  @relation(fields: [orderId], references: [id])
  product product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model orderReports {
  id        String   @id
  orderId   String
  userId    String
  url       String
  signature String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  user   @relation(fields: [userId], references: [id])
  order orders @relation(fields: [orderId], references: [id])

  @@map("order_reports")
}

model pushSubscription {
  id        String   @id
  userId    String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model notification {
  id         String    @id
  text       String
  type       String
  to         String
  metadata   String?   // JSON string for additional data like download URLs
  readableAt DateTime? @map("readable_at")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user user @relation(fields: [to], references: [id])
}

model department {
  id          String    @id
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        user[]
  product     product[]

  @@map("departments")
}

enum reportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("report_status")
}

enum reportType {
  PRODUCTS
  ORDERS
  MOVEMENTS
  STOCK
  USERS

  @@map("report_type")
}

model report {
  id           String       @id
  type         reportType
  userId       String
  departmentId String?
  fileName     String
  filePath     String?
  status       reportStatus @default(PENDING)
  parameters   String?      // JSON string for report filters/parameters
  errorMessage String?      @map("error_message")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user user @relation(fields: [userId], references: [id])

  @@map("reports")
}
